<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wegyde_crm_custom_fields" model="ir.ui.view">
        <field name="name">Crm Custom Fields</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="institute_crm.view_institute_crm_lead_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_interested']" position="after">
                <field name="subject" string="Subject Interested"/>
            </xpath>
            <xpath expr="//field[@name='contact_status']" position="after">
                <field name="lead_quality"/>
            </xpath>
            <xpath expr="//field[@name='student_name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='student_phone']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="is_won_stage" invisible="1"/>

                <button name="act_create_student"
                        type="object"
                        string="Create Student"
                        class="btn-primary"
                        invisible="not is_won_stage or student_created"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="student_created" invisible="1"/>
                <button name="action_open_student"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user"
                        invisible="not student_created">
                    <field name="student_id" invisible="1"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Student Profile</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
    <record id="student_creation_wizard_view_form" model="ir.ui.view">
        <field name="name">create.student.wizard.view.form</field>
        <field name="model">create.student.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Student">
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="course_id"/>
                    </group>

                    <footer>
                        <button name="action_create_student"
                                type="object"
                                string="Create Student"
                                class="btn-primary"/>

                        <button string="Cancel"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="crm_case_kanban_view_leads_inherit_student" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.student</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <div>
                    <field name="student_phone"/>
                </div>
                <div>
                    <field name="lead_quality"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="crm_case_list_view_leads_inherit_student" model="ir.ui.view">
        <field name="name">crm.lead.list.inherit.student</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="student_phone"/>
                <field name="lead_quality"/>
            </xpath>

        </field>
    </record>
</odoo>