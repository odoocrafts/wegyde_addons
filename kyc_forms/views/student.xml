<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_student_student_form_inherit_kyc" model="ir.ui.view">
        <field name="name">student.student.form.kyc</field>
        <field name="model">student.student</field>
        <field name="inherit_id" ref="wegyde_student_management.wegyde_student_custom_fields"/>
        <field name="arch" type="xml">
            <!-- Smart Button in Button Box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_kyc_url"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-globe">
                    <div class="o_stat_info">
                        <span class="o_stat_text">KYC Form</span>
                        <span class="o_stat_value">
                            <field name="kyc_status"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <!-- KYC Link with One-Click Copy Widget -->
            <xpath expr="//field[@name='contract_file']" position="after">
                <!-- Field Label on the left -->
                <label for="kyc_url" string="KYC Form Link"/>

                <!-- Button on the right -->
                <div class="o_row">
                    <field name="kyc_url"
                           widget="CopyClipboardButton"
                           string="Copy KYC Link"
                           class="btn btn-secondary"
                    />
                </div>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='email']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="action_change_payment_status" model="ir.actions.server">
        <field name="name">Change Payment status</field>
        <field name="model_id" ref="student_management.model_student_student"/>
        <field name="binding_model_id" ref="student_management.model_student_student"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.act_change_paid()
        </field>
    </record>


</odoo>