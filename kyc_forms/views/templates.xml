<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kyc_admission_form_template" name="WeGyde Admission - KYC Form">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </t>
            <div id="wrap" class="oe_structure oe_empty" style="min-height: 100vh; background-color: #f1f5f9;">
                <div class="container py-4 py-md-5 px-2 px-sm-3 px-md-4">
                    <div class="row justify-content-center">
                        <div class="col-12 col-lg-9 col-xl-8">
                            <div class="card border-0 shadow-sm kyc-main-card">
                                
                                <!-- Form Header -->
                                <div class="card-header bg-white text-center pt-4 pb-3 border-0">
                                    <h3 class="fw-bold text-dark mb-1" style="font-size: 1.65rem; letter-spacing: -0.2px;">WeGyde Admission - KYC Form</h3>
                                </div>

                                <div class="card-body p-3 p-sm-4 p-md-5 pt-0">

                                    <t t-if="error">
                                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 8px;">
                                            <span class="fa fa-exclamation-triangle me-2"/>
                                            <t t-esc="error"/>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    </t>

                                    <form action="/kyc/admission/submit" method="post" enctype="multipart/form-data"
                                          class="needs-validation" id="kyc_admission_form" novalidate="novalidate">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <!-- 1. Name -->
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold text-dark">Name <span class="text-danger">*</span></label>
                                            <div class="row g-2">
                                                <div class="col-12 col-sm-6">
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light text-muted border-end-0"><i class="fa fa-user-o"/></span>
                                                        <input type="text" class="form-control kyc-input border-start-0" id="first_name" name="first_name" 
                                                               required="required" placeholder="First Name"
                                                               t-att-value="values.get('first_name') if values else ''"/>
                                                    </div>
                                                    <small class="text-muted" style="font-size: 0.75rem;">First Name</small>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <input type="text" class="form-control kyc-input" id="last_name" name="last_name" 
                                                           required="required" placeholder="Last Name"
                                                           t-att-value="values.get('last_name') if values else ''"/>
                                                    <small class="text-muted" style="font-size: 0.75rem;">Last Name</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- 2. Mobile Number -->
                                        <div class="mb-4">
                                            <label for="phone" class="form-label fw-semibold text-dark">Mobile Number (WhatsApp number) <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted border-end-0"><i class="fa fa-phone"/></span>
                                                <input type="tel" class="form-control kyc-input border-start-0" id="phone" name="phone" 
                                                       required="required" placeholder="Mobile Number"
                                                       t-att-value="values.get('phone') if values else ''"/>
                                            </div>
                                        </div>

                                        <!-- 3. Email -->
                                        <div class="mb-4">
                                            <label for="email" class="form-label fw-semibold text-dark">Email <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted border-end-0"><i class="fa fa-envelope-o"/></span>
                                                <input type="email" class="form-control kyc-input border-start-0" id="email" name="email" 
                                                       required="required" placeholder="yourname@domain.com"
                                                       t-att-value="values.get('email') if values else ''"/>
                                            </div>
                                        </div>

                                        <!-- 4. Date of Birth -->
                                        <div class="mb-4">
                                            <label for="dob" class="form-label fw-semibold text-dark">Date of Birth <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted border-end-0"><i class="fa fa-calendar"/></span>
                                                <input type="date" class="form-control kyc-input border-start-0" id="dob" name="dob" 
                                                       required="required"
                                                       t-att-value="values.get('dob') if values else ''"/>
                                            </div>
                                            <small class="text-muted" style="font-size: 0.75rem;">dd-MMM-yyyy</small>
                                        </div>

                                        <!-- 5. Image Upload (Max 1MB) -->
                                        <div class="mb-4">
                                            <label for="image_file" class="form-label fw-semibold text-dark">Image Upload</label>
                                            <div class="p-3 border rounded-3 bg-light text-center image-upload-box">
                                                <input type="file" class="form-control" id="image_file" name="image_file" accept="image/*"
                                                       style="font-size: 14px;"/>
                                                <div id="image_size_error" class="text-danger small mt-2 d-none fw-semibold">
                                                    <i class="fa fa-exclamation-circle me-1"/> Image file size must be 1 MB or less. Please select a smaller image.
                                                </div>
                                            </div>
                                            <small class="text-muted d-block mt-2" style="font-size: 0.8rem; line-height: 1.4;">
                                                Please note that the photo is part of KYC form. We will not use your photo for any social media promotion without your permission. (Max 1 MB)
                                            </small>
                                        </div>

                                        <!-- 6. Highest Qualification -->
                                        <div class="mb-4">
                                            <label for="highest_qualification" class="form-label fw-semibold text-dark">Highest Qualification <span class="text-danger">*</span></label>
                                            <select class="form-select kyc-input" id="highest_qualification" name="highest_qualification" required="required">
                                                <option value="" disabled="disabled" selected="selected">- Select -</option>
                                                <option value="12th Pass">12th Pass</option>
                                                <option value="Graduation (B.Com, BBA etc)">Graduation (B.Com, BBA etc)</option>
                                                <option value="CA Inter">CA Inter</option>
                                                <option value="CA">CA</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>

                                        <!-- 7. Address -->
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold text-dark">Address <span class="text-danger">*</span></label>
                                            <div class="row g-2">
                                                <div class="col-12 mb-2">
                                                    <input type="text" class="form-control kyc-input" id="street" name="street" 
                                                           required="required" placeholder="Street Address"
                                                           t-att-value="values.get('street') if values else ''"/>
                                                    <small class="text-muted" style="font-size: 0.75rem;">Street Address</small>
                                                </div>
                                                <div class="col-12 mb-2">
                                                    <input type="text" class="form-control kyc-input" id="street2" name="street2" 
                                                           placeholder="Address Line 2"
                                                           t-att-value="values.get('street2') if values else ''"/>
                                                    <small class="text-muted" style="font-size: 0.75rem;">Address Line 2</small>
                                                </div>
                                                <div class="col-12 col-sm-6 mb-2">
                                                    <input type="text" class="form-control kyc-input" id="city" name="city" 
                                                           required="required" placeholder="City"
                                                           t-att-value="values.get('city') if values else ''"/>
                                                    <small class="text-muted" style="font-size: 0.75rem;">City</small>
                                                </div>
                                                <div class="col-12 col-sm-6 mb-2">
                                                    <input type="text" class="form-control kyc-input" id="state" name="state" 
                                                           required="required" placeholder="State/Region/Province"
                                                           t-att-value="values.get('state') if values else ''"/>
                                                    <small class="text-muted" style="font-size: 0.75rem;">State/Region/Province</small>
                                                </div>
                                                <div class="col-12 col-sm-6 mb-2">
                                                    <input type="text" class="form-control kyc-input" id="zip_code" name="zip_code" 
                                                           required="required" placeholder="Postal / Zip Code"
                                                           t-att-value="values.get('zip_code') if values else ''"/>
                                                    <small class="text-muted" style="font-size: 0.75rem;">Postal / Zip Code</small>
                                                </div>
                                                <div class="col-12 col-sm-6 mb-2">
                                                    <select class="form-select kyc-input" id="country" name="country" required="required">
                                                        <option value="" disabled="disabled" selected="selected">- Select Country -</option>
                                                        <option value="India">India</option>
                                                        <option value="United Arab Emirates">United Arab Emirates</option>
                                                        <option value="United Kingdom">United Kingdom</option>
                                                        <option value="United States">United States</option>
                                                        <option value="Oman">Oman</option>
                                                        <option value="Saudi Arabia">Saudi Arabia</option>
                                                        <option value="Bahrain">Bahrain</option>
                                                        <option value="Qatar">Qatar</option>
                                                        <option value="Kuwait">Kuwait</option>
                                                        <option value="Singapore">Singapore</option>
                                                        <option value="Malaysia">Malaysia</option>
                                                        <option value="Nepal">Nepal</option>
                                                        <option value="Sri Lanka">Sri Lanka</option>
                                                    </select>
                                                    <small class="text-muted" style="font-size: 0.75rem;">Country</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- 8. ACCA Registration Number -->
                                        <div class="mb-4">
                                            <label for="acca_reg_number" class="form-label fw-semibold text-dark">ACCA Registration Number <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted border-end-0"><i class="fa fa-id-card-o"/></span>
                                                <input type="text" class="form-control kyc-input border-start-0" id="acca_reg_number" name="acca_reg_number" 
                                                       required="required" placeholder="Enter ACCA Registration Number"
                                                       t-att-value="values.get('acca_reg_number') if values else ''"/>
                                            </div>
                                            <small class="text-muted d-block mt-2" style="font-size: 0.8rem; line-height: 1.4;">
                                                We are requesting your ACCA registration number for 2 reasons: 1. We are required to share the data with ACCA the students who took the classes from us as approved employer 2. To provide you the Mock Exams via ACCA portal
                                            </small>
                                        </div>

                                        <!-- 9. Language -->
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold text-dark">Language <span class="text-danger">*</span></label>
                                            <div class="d-flex flex-column gap-2" id="language_group">
                                                <div class="form-check">
                                                    <input class="form-check-input lang-cb" type="checkbox" name="languages" id="lang_hindi" value="Hindi"/>
                                                    <label class="form-check-label text-dark" for="lang_hindi">Hindi</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input lang-cb" type="checkbox" name="languages" id="lang_english" value="English"/>
                                                    <label class="form-check-label text-dark" for="lang_english">English</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input lang-cb" type="checkbox" name="languages" id="lang_malayalam" value="Malayalam"/>
                                                    <label class="form-check-label text-dark" for="lang_malayalam">Malayalam</label>
                                                </div>
                                            </div>
                                            <div id="language_error" class="text-danger small mt-1 d-none">
                                                Please select at least one language.
                                            </div>
                                        </div>

                                        <!-- 10. WeGyde - Pursuing Subject and Package Matrix -->
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold text-dark mb-2">WeGyde - Pursuing Subject and Package</label>
                                            <div class="table-responsive border rounded-3 bg-white shadow-sm">
                                                <table class="table table-hover align-middle mb-0 matrix-table">
                                                    <thead class="bg-light text-secondary small">
                                                        <tr>
                                                            <th style="min-width: 220px; font-weight: 600;">Subject</th>
                                                            <th class="text-center" style="width: 80px; font-weight: 600;">Basic</th>
                                                            <th class="text-center" style="width: 80px; font-weight: 600;">Standard</th>
                                                            <th class="text-center" style="width: 80px; font-weight: 600;">Premium</th>
                                                            <th class="text-center" style="width: 80px; font-weight: 600;">Offline</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="subjects" t-as="subj">
                                                            <tr>
                                                                <td class="small fw-semibold text-dark">
                                                                    <t t-esc="subj[1]"/>
                                                                </td>
                                                                <td class="text-center">
                                                                    <input class="form-check-input matrix-radio" type="radio" 
                                                                           t-att-name="'pkg_' + subj[0]" value="Basic"/>
                                                                </td>
                                                                <td class="text-center">
                                                                    <input class="form-check-input matrix-radio" type="radio" 
                                                                           t-att-name="'pkg_' + subj[0]" value="Standard"/>
                                                                </td>
                                                                <td class="text-center">
                                                                    <input class="form-check-input matrix-radio" type="radio" 
                                                                           t-att-name="'pkg_' + subj[0]" value="Premium"/>
                                                                </td>
                                                                <td class="text-center">
                                                                    <input class="form-check-input matrix-radio" type="radio" 
                                                                           t-att-name="'pkg_' + subj[0]" value="Offline"/>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <small class="text-muted d-block mt-2" style="font-size: 0.8rem;">
                                                Select the appropriate Subject and package you are currently pursuing from WeGyde App
                                            </small>
                                        </div>

                                        <!-- 11. How did you get to know us? -->
                                        <div class="mb-5">
                                            <label for="referral_source" class="form-label fw-semibold text-dark">How did you get to know us? <span class="text-danger">*</span></label>
                                            <select class="form-select kyc-input" id="referral_source" name="referral_source" required="required">
                                                <option value="" disabled="disabled" selected="selected">- Select -</option>
                                                <option value="Linkedin">Linkedin</option>
                                                <option value="Instagram &amp; Facebook">Instagram &amp; Facebook</option>
                                                <option value="Youtube">Youtube</option>
                                                <option value="Friend's Referral">Friend's Referral</option>
                                                <option value="Google Search">Google Search</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>

                                        <!-- Submit Button -->
                                        <div class="text-center pt-2 mb-3">
                                            <button type="submit" id="kyc_submit_btn" class="btn btn-teal px-5 py-2 fw-bold text-white shadow-sm"
                                                    style="background-color: #20c997; border-radius: 24px; min-width: 140px; font-size: 1rem; border: none; transition: all 0.2s;">
                                                Submit
                                            </button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <style type="text/css">
                    <![CDATA[
                    html, body {
                        height: auto !important;
                        overflow-y: auto !important;
                        background-color: #f1f5f9;
                    }
                    .kyc-main-card {
                        border-radius: 12px;
                        background: #ffffff;
                    }
                    .kyc-input {
                        border-radius: 6px !important;
                        border: 1px solid #ced4da !important;
                        font-size: 15px !important;
                        padding: 0.55rem 0.75rem !important;
                    }
                    .kyc-input:focus {
                        border-color: #20c997 !important;
                        box-shadow: 0 0 0 0.2rem rgba(32, 201, 151, 0.2) !important;
                    }
                    .btn-teal:hover {
                        background-color: #17a077 !important;
                        transform: translateY(-1px);
                    }
                    .matrix-table th, .matrix-table td {
                        padding: 0.65rem 0.75rem;
                    }
                    .matrix-radio {
                        width: 1.15em;
                        height: 1.15em;
                        cursor: pointer;
                    }
                    .matrix-radio:checked {
                        background-color: #20c997;
                        border-color: #20c997;
                    }
                    .form-check-input:checked {
                        background-color: #20c997;
                        border-color: #20c997;
                    }
                    ]]>
                </style>

                <script type="text/javascript">
                    <![CDATA[
                    document.addEventListener('DOMContentLoaded', function () {
                        const form = document.getElementById('kyc_admission_form');
                        const imageInput = document.getElementById('image_file');
                        const sizeError = document.getElementById('image_size_error');
                        const submitBtn = document.getElementById('kyc_submit_btn');
                        const langCheckboxes = document.querySelectorAll('.lang-cb');
                        const langError = document.getElementById('language_error');

                        // 1MB = 1048576 bytes
                        const MAX_SIZE = 1048576;

                        if (imageInput) {
                            imageInput.addEventListener('change', function () {
                                if (this.files && this.files[0]) {
                                    if (this.files[0].size > MAX_SIZE) {
                                        if (sizeError) sizeError.classList.remove('d-none');
                                        this.value = ''; // clear input
                                    } else {
                                        if (sizeError) sizeError.classList.add('d-none');
                                    }
                                }
                            });
                        }

                        langCheckboxes.forEach(cb => {
                            cb.addEventListener('change', function () {
                                let checked = false;
                                langCheckboxes.forEach(c => { if (c.checked) checked = true; });
                                if (checked && langError) langError.classList.add('d-none');
                            });
                        });

                        // Double click radio to deselect
                        const radios = document.querySelectorAll('.matrix-radio');
                        radios.forEach(radio => {
                            radio.addEventListener('click', function (e) {
                                if (this.dataset.wasChecked === 'true') {
                                    this.checked = false;
                                    this.dataset.wasChecked = 'false';
                                } else {
                                    // Set others in group to false
                                    document.querySelectorAll(`input[name="${this.name}"]`).forEach(r => {
                                        r.dataset.wasChecked = 'false';
                                    });
                                    this.dataset.wasChecked = 'true';
                                }
                            });
                        });

                        if (form) {
                            form.addEventListener('submit', function (e) {
                                // Check language selection
                                let langSelected = false;
                                langCheckboxes.forEach(c => { if (c.checked) langSelected = true; });
                                if (!langSelected) {
                                    e.preventDefault();
                                    if (langError) {
                                        langError.classList.remove('d-none');
                                        langError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                    }
                                    return;
                                }

                                if (!form.checkValidity()) {
                                    e.preventDefault();
                                    form.classList.add('was-validated');
                                    const firstInvalid = form.querySelector(':invalid');
                                    if (firstInvalid) {
                                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                        firstInvalid.focus();
                                    }
                                    return;
                                }

                                if (submitBtn) {
                                    submitBtn.disabled = true;
                                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Submitting...';
                                }
                            });
                        }
                    });
                    ]]>
                </script>
            </div>
        </t>
    </template>

    <template id="kyc_admission_success_template" name="KYC Form Submitted Successfully">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
                <style type="text/css">
                    html, body {
                        height: auto !important;
                        overflow-y: auto !important;
                        background-color: #f1f5f9;
                    }
                </style>
            </t>
            <div id="wrap" class="oe_structure oe_empty" style="min-height: 100vh;">
                <div class="container py-4 py-md-5 text-center px-3">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-6">
                            <div class="card border-0 shadow-sm py-4 py-md-5 px-3 px-md-4"
                                 style="border-radius: 16px; background: #ffffff;">
                                <div class="mb-4">
                                    <span class="d-inline-flex align-items-center justify-content-center text-white rounded-circle"
                                          style="width: 76px; height: 76px; font-size: 36px; background-color: #20c997; box-shadow: 0 4px 12px rgba(32, 201, 151, 0.4);">
                                        <span class="fa fa-check"/>
                                    </span>
                                </div>
                                <h2 class="text-dark mb-2 fw-bold" style="font-size: 1.6rem;">KYC Form Submitted!</h2>
                                <p class="lead text-muted mb-4" style="font-size: 1.05rem;">Thank you, <strong class="text-dark" t-esc="kyc.name"/>! Your WeGyde Admission &amp; KYC details have been recorded successfully.
                                </p>

                                <div class="bg-light p-3 p-md-4 mb-4 border text-start" style="border-radius: 12px;">
                                    <div class="row small text-muted mb-2 pb-2 border-bottom">
                                        <div class="col-5">
                                            <strong>Student Name:</strong>
                                        </div>
                                        <div class="col-7 text-dark fw-semibold">
                                            <t t-esc="kyc.name"/>
                                        </div>
                                    </div>
                                    <div class="row small text-muted mb-2 pb-2 border-bottom">
                                        <div class="col-5">
                                            <strong>Mobile (WhatsApp):</strong>
                                        </div>
                                        <div class="col-7 text-dark">
                                            <t t-esc="kyc.phone"/>
                                        </div>
                                    </div>
                                    <div class="row small text-muted mb-2 pb-2 border-bottom">
                                        <div class="col-5">
                                            <strong>Email:</strong>
                                        </div>
                                        <div class="col-7 text-dark">
                                            <t t-esc="kyc.email"/>
                                        </div>
                                    </div>
                                    <div class="row small text-muted mb-2 pb-2 border-bottom">
                                        <div class="col-5">
                                            <strong>ACCA Reg No:</strong>
                                        </div>
                                        <div class="col-7 text-dark">
                                            <t t-esc="kyc.acca_reg_number"/>
                                        </div>
                                    </div>
                                    <div class="row small text-muted">
                                        <div class="col-5">
                                            <strong>Qualification:</strong>
                                        </div>
                                        <div class="col-7 text-dark">
                                            <t t-esc="kyc.highest_qualification"/>
                                        </div>
                                    </div>
                                </div>

                                <p class="text-muted mb-4 small">Our academic support team will verify your admission details shortly.
                                </p>
                                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                                    <a href="/kyc/admission" class="btn btn-outline-secondary px-4 py-2"
                                       style="border-radius: 20px; font-weight: 500;">
                                        Submit Another Form
                                    </a>
                                    <a href="/" class="btn px-4 py-2 text-white fw-semibold"
                                       style="border-radius: 20px; background-color: #20c997; border: none;">
                                        Back to Home
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
